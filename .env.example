# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# wrapper-manager (the Docker Compose service uses this address).
WRAPPER_ADDR=wrapper-manager:8080
WRAPPER_TLS=false
STOREFRONT=us
LANGUAGE=en-US
LYRICS_FALLBACK=true
LYRICS_FALLBACK_URL=https://lrclib.net

# auto: try wrapper-manager audio, fall back to Apple's 30s preview
# preview: always use the public preview
# full: require an FFmpeg-readable full asset from wrapper-manager
AUDIO_MODE=auto

# file: one MP4 per selected track; hls: live stream.m3u8; rtmp: push to RTMP_URL
STREAM_MODE=hls
RTMP_URL=
LISTEN_ADDR=:8088
PUBLIC_BASE_URL=http://localhost:8088

VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
MAX_RESULTS=5
OUTPUT_DIR=output
WORK_DIR=work
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
